{
  "name": "rragent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.client.config.mjs",
    "start": "node dist/rragent.js serve",
    "test": "cljf build @cljs.edn :test && node target/test/rragent/test_runner.js",
    "repl": "cljf repl",
    "prebuild": "node scripts/version.mjs",
    "release": "npm run build && tar -czf rragent.tar.gz -C dist . && sha256sum rragent.tar.gz > rragent.tar.gz.sha256"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "@yume-chan/stream-extra": "2.6.1",
    "croner": "^10.0.1",
    "markdown-it": "15.0.3",
    "papaparse": "5.7.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "clojurific": "0.12.7",
    "nbb": "1.6.214",
    "vite": "^8.3.4"
  }
}
