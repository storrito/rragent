#!/usr/bin/env node
// render <project-dir> <output.mp4>: the video of a HyperFrames project
// through the HyperFrames CLI, `hyperframes render . --output <out>` in
// the project's composition/, with the values of the project's
// variables.json and the Chrome of the machine (CHROME and HYPERFRAMES
// in the environment, from rragent, see TEMPLATE.md). The CLI's progress
// lines, `@hf-progress {"pct": 30, ...}`, become `progress 30%` lines,
// which rragent shows; everything else passes through. The CLI's exit
// status is this script's. RRAGENT_RENDER_ARGS adds arguments for the
// CLI, `--browser-gpu` on a machine with a graphics card for example.
//
// An element of index.html marked `data-preview-only` shows in the
// player beside the chat but not in the video: Instagram's stickers that
// Storrito lays over the finished video itself, a guide. The render then
// takes a hidden copy of index.html without them, `.render-index.html`
// beside it (so that every path in it stays the same), through the
// CLI's --composition; the copy goes with the render.
//
// The CLI keeps its work folder (the frames, the compiled composition,
// the sound) beside the file it writes, and rragent lists every file
// under artifacts/ that is not hidden: rendering into artifacts/ itself
// showed dozens of files while it ran. So the CLI writes into a hidden
// folder beside the output, `.render-<name>/`, and the finished video is
// moved to <out> only when the render succeeded; the folder goes in any
// case, so a half-written video never shows either.
import { spawn } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import readline from "node:readline";

const [projectDir, out] = process.argv.slice(2);
if (!projectDir || !out) {
  console.error("render <project-dir> <out.mp4>");
  process.exit(2);
}

const target = path.resolve(out);
const staging = path.join(path.dirname(target), `.render-${path.basename(target, path.extname(target))}`);
const staged = path.join(staging, path.basename(target));
const composition = path.join(path.resolve(projectDir), "composition");
const previewless = path.join(composition, ".render-index.html");
// the folder and the copy gone; a CLI still writing into them after a stop may keep them, hidden, until the next render
const clean = () => {
  for (const p of [staging, previewless]) {
    try {
      fs.rmSync(p, { recursive: true, force: true });
    } catch {
      // left for the next render's clean
    }
  }
};
let stopping = false;
clean();
fs.mkdirSync(staging, { recursive: true });

const variables = path.join(path.resolve(projectDir), "variables.json");
const cli = process.env.HYPERFRAMES || "hyperframes";
const chrome = process.env.CHROME;
const extra = (process.env.RRAGENT_RENDER_ARGS || "").trim().split(/\s+/).filter(Boolean);
const args = ["render", ".", "--output", staged, ...extra];
if (fs.existsSync(variables)) args.push("--variables-file", variables);

// html without its elements marked data-preview-only: each from its
// opening tag to its matching closing tag (one of the same name, the
// nesting counted), or the tag alone when it is empty or self-closing
const VOID = new Set(["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"]);
function withoutPreviewOnly(html) {
  const marked = /<([a-zA-Z][\w-]*)\b[^>]*?\sdata-preview-only(?=[\s=>/])[^>]*>/;
  let out = html;
  for (let m = marked.exec(out); m; m = marked.exec(out)) {
    const name = m[1].toLowerCase();
    let end = m.index + m[0].length;
    if (!VOID.has(name) && !m[0].endsWith("/>")) {
      const tags = new RegExp(`<(/?)${name}\\b[^>]*>`, "gi");
      tags.lastIndex = end;
      let depth = 1;
      for (let t = tags.exec(out); t; t = tags.exec(out)) {
        depth += t[1] ? -1 : t[0].endsWith("/>") ? 0 : 1;
        if (depth === 0) {
          end = t.index + t[0].length;
          break;
        }
      }
      if (depth !== 0) end = out.length;
    }
    out = out.slice(0, m.index) + out.slice(end);
  }
  return out;
}
const index = path.join(composition, "index.html");
if (fs.existsSync(index)) {
  const html = fs.readFileSync(index, "utf8");
  if (/\sdata-preview-only(?=[\s=>/])/.test(html)) {
    fs.writeFileSync(previewless, withoutPreviewOnly(html));
    args.push("--composition", path.basename(previewless));
  }
}

const env = {
  ...process.env,
  HYPERFRAMES_NO_TELEMETRY: "1",
  HYPERFRAMES_SKIP_SKILLS: "1",
  PUPPETEER_SKIP_DOWNLOAD: "1",
  ...(chrome ? { HYPERFRAMES_BROWSER_PATH: chrome, PRODUCER_HEADLESS_SHELL_PATH: chrome } : {}),
};

const child = spawn(cli, args, { cwd: composition, env, stdio: ["ignore", "pipe", "inherit"] });
readline.createInterface({ input: child.stdout }).on("line", (line) => {
  const progress = /^@hf-progress\s+(\{.*\})\s*$/.exec(line);
  if (progress) {
    try {
      const pct = JSON.parse(progress[1]).pct;
      if (typeof pct === "number") console.log(`progress ${Math.round(pct)}%`);
      return;
    } catch {
      // not the CLI's JSON: shown as it is
    }
  }
  console.log(line);
});
child.on("error", (error) => {
  console.error(`${cli}: ${error.message}`);
  clean();
  process.exit(1);
});
child.on("close", (code, signal) => {
  // a stopped render puts nothing in place, whatever the CLI did after the signal
  if (stopping) return;
  const status = code ?? (signal ? 1 : 0);
  if (status === 0 && !fs.existsSync(staged)) {
    console.error(`${cli} ended without writing ${path.basename(target)}`);
    clean();
    process.exit(1);
  }
  if (status === 0) {
    try {
      fs.renameSync(staged, target);
    } catch (error) {
      console.error(`the video could not be put in place as ${path.basename(target)}: ${error.message}`);
      clean();
      process.exit(1);
    }
  }
  clean();
  process.exit(status);
});
// stopped (the person's Stop): the CLI goes with the process group, the folder with this
for (const name of ["SIGTERM", "SIGINT"]) {
  process.on(name, () => {
    stopping = true;
    child.kill(name);
    clean();
    process.exit(name === "SIGTERM" ? 143 : 130);
  });
}
