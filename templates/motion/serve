#!/usr/bin/env node
// serve <project-dir>: the process of a motion project, its page on PORT
// (see TEMPLATE.md and rragent.motion.app). The program is the bundle
// built next to this file, dist/motion.js (npm run build in rragent's
// root); RRAGENT_MOTION_JS names another build of it, the tests' one.
import { pathToFileURL } from "node:url";

const program = process.env.RRAGENT_MOTION_JS
  ? pathToFileURL(process.env.RRAGENT_MOTION_JS).href
  : new URL("./dist/motion.js", import.meta.url).href;
const { main } = await import(program);
await main("serve", process.argv[2]);
