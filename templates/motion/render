#!/usr/bin/env node
// render <project-dir> <output.mp4>: the video of a motion project, every
// frame screenshot by a headless Chrome (CHROME in the environment, from
// rragent) and encoded by ffmpeg, `progress n/m` lines on stdout as the
// progress (see TEMPLATE.md and rragent.motion.render). The program is
// the bundle built next to this file, dist/motion.js (npm run build in
// rragent's root); RRAGENT_MOTION_JS names another build of it.
import { pathToFileURL } from "node:url";

const program = process.env.RRAGENT_MOTION_JS
  ? pathToFileURL(process.env.RRAGENT_MOTION_JS).href
  : new URL("./dist/motion.js", import.meta.url).href;
const { main } = await import(program);
await main("render", process.argv[2], process.argv[3]);
